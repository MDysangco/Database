<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <StartupScript>(Blank)</StartupScript>
    <StartAction>StartNone</StartAction>
    <TargetConnectionString>Data Source=(localdb)\Development;Initial Catalog=Candice;Integrated Security=True;Persist Security Info=False;Pooling=False;Multiple Active Result Sets=False;Encrypt=True;Trust Server Certificate=False;Command Timeout=0</TargetConnectionString>
    <TargetDatabase>Candice</TargetDatabase>
    <CreateNewDatabase>False</CreateNewDatabase>
  </PropertyGroup>
</Project>